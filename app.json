{
  "expo": {
    "name": "Draconic Codex",
    "slug": "draconic-codex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "draconiccodex",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2C1810"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alejandro.samuel.draconiccodex"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2C1810"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ],
      "package": "com.alejandro.samuel.draconiccodex"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para añadir imágenes de criaturas.",
          "cameraPermission": "La app necesita acceso a la cámara para tomar fotos de criaturas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}